// Verevia — Core-Datenmodell (Phase 2)
//
// Technisches Fundament für Multi-Tenancy/Identity/RBAC, siehe:
//   - docs/database/Database.md (fachlicher Entwurf)
//   - docs/AUTH_IDENTITY_RBAC_ARCHITEKTUR.md (Account/Person-Trennung, RoleAssignment, PersonRelationship)
//   - docs/ARCHITEKTUR_FINALISIERUNG.md (finales RoleAssignment-Modell, RLS-Konzept)
//   - docs/architecture/adr/0002-0006 (ACCEPTED)
//
// Noch NICHT enthalten: Event/Attendance/Task/
// Notification/AuditLog/JointTeam — folgen in einem eigenen, fachlichen
// Arbeitspaket. Season/AgeGroup/TeamSeason (Fußball-Saisonverwaltung)
// kamen in Phase 9 hinzu, siehe docs/PHASE_9_FOOTBALL_SEASON_REPORT.md.
// Venue/FootballMatch (Spielstätten- und Spielgrundmodell) kamen in
// Phase 10 hinzu, siehe docs/PHASE_10_MATCH_FOUNDATION_REPORT.md.
// FootballTournament/TournamentParticipant/TournamentVenue/TournamentGroup
// (Turnier-Grundmodell, kein automatischer Spielplan/Bracket-Generator)
// kamen in Phase 11 hinzu, siehe docs/PHASE_11_TOURNAMENT_CORE_REPORT.md
// und docs/architecture/adr/0008-tournament-match-model.md. Der
// automatische Gruppenphasen-Spielplan (Round-Robin, keine neue Tabelle)
// kam in Phase 12 hinzu, siehe
// docs/PHASE_12_TOURNAMENT_SCHEDULE_GENERATOR_REPORT.md und
// docs/architecture/adr/0009-tenant-scoped-multi-statement-transactions.md.
// TournamentMatchSlot (KO-/Finalrunden-Grundfundament — beschreibt noch
// nicht aufgelöste Spielteilnehmer wie "Sieger Halbfinale 1", noch keine
// automatische Auflösung nach Ergebnissen) kam in Phase 13 hinzu, siehe
// docs/PHASE_13_TOURNAMENT_KNOCKOUT_GENERATOR_REPORT.md und
// docs/architecture/adr/0010-knockout-pending-match-slots.md. Die
// automatische Auflösung von TournamentMatchSlot nach Spielabschluss
// (WinnerOfMatch/LoserOfMatch-Propagierung, FootballMatch.resultPropagatedAt)
// kam in Phase 14 hinzu, siehe
// docs/PHASE_14_TOURNAMENT_MATCH_SLOT_RESOLUTION_REPORT.md und
// docs/architecture/adr/0011-propagated-result-immutability.md.
// Prisma ist absichtlich auf ^6.x gepinnt (nicht 7), siehe
// docs/architecture/adr/0002-authentication-strategy.md.
//
// RLS-Hinweis: Row-Level-Security wird NICHT deklarativ über Prisma
// abgebildet (Prisma 6 hat dafür keine native Unterstützung), sondern
// gezielt per SQL-Migration ergänzt — siehe die Migration, die auf die
// `prisma migrate dev`-Migration dieses Schemas folgt, sowie
// docs/PHASE_2_CORE_REPORT.md, Abschnitt "RLS-Implementierung".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// Vereinsrollen, siehe docs/product/Roles-and-Permissions.md.
/// Plattformrollen sind bewusst ein eigenes Enum (PlatformRole), siehe ADR 0004.
enum Role {
  TENANT_ADMIN
  DEPARTMENT_ADMIN
  YOUTH_DIRECTOR
  TEAM_MANAGER
  COACH
  ASSISTANT_COACH
  PLAYER
  MEMBER
  GUEST
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

enum ScopeType {
  TENANT
  DEPARTMENT
  TEAM
}

/// Elternteil/Sorgeberechtigter ist bewusst KEINE RBAC-Rolle, siehe ADR 0005.
enum RelationshipType {
  PARENT
  LEGAL_GUARDIAN
  EMERGENCY_CONTACT
}

enum RelationshipStatus {
  PENDING
  VERIFIED
  REVOKED
}

/// Lebenszyklus einer TeamMember-Zeile — bewusst nur zwei Zustände, keine
/// weitergehende Historisierung (kein validFrom/validUntil, kein Audit-Log)
/// in dieser Phase, siehe TeamMember-Kommentar.
enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

/// Grobe Sportart-Klassifizierung einer `Department` (Phase 9). Bewusst ein
/// Enum statt einer konfigurierbaren Entity — siehe Abschnitt "Sportart" in
/// docs/PHASE_9_FOOTBALL_SEASON_REPORT.md: die Liste der Sportarten eines
/// typischen deutschen Mehrsparten-Vereins ist klein und ändert sich
/// selten; eine eigene verwaltbare Entity (mit CRUD/Seed/Admin-UI) wäre für
/// diesen Zweck unnötige Komplexität. Erweiterbar durch simples Hinzufügen
/// eines neuen Werts, keine Migration bestehender Daten nötig. `OTHER` ist
/// der bewusste Auffangwert für alles, was (noch) keinen eigenen Wert hat —
/// keine erschöpfende Sportarten-Liste, siehe Auftrag ("keinen riesigen
/// Sportarten-Katalog implementieren").
enum SportType {
  FOOTBALL
  TENNIS
  STOCK_SPORT
  CYCLING
  OTHER
}

/// Lebenszyklus einer `Season`. Bewusst nur drei Zustände, keine
/// weitergehende Workflow-Engine (analog zu `TeamMemberStatus`/
/// `AccountInvitationStatus`).
enum SeasonStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

/// Lebenszyklus einer `TeamSeason`-Zuordnung — identisches Muster zu
/// `TeamMemberStatus` (siehe dort): eine Mannschaft kann sich aus einer
/// Saison zurückziehen, ohne dass die Zeile gelöscht wird.
enum TeamSeasonStatus {
  ACTIVE
  INACTIVE
}

/// Lebenszyklus einer `Venue` (Phase 10) — identisches, bewusst schlankes
/// Zwei-Zustands-Muster wie `TeamMemberStatus`/`TeamSeasonStatus`: eine
/// Spielstätte kann außer Nutzung genommen werden (z. B. Bauarbeiten,
/// dauerhaft geschlossen), ohne die Zeile zu löschen (an ihr hängen
/// FootballMatch-Referenzen).
enum VenueStatus {
  ACTIVE
  INACTIVE
}

/// Art eines Spiels (Phase 10). `CUP` bewusst mit aufgenommen (nicht nur
/// LEAGUE/FRIENDLY/TOURNAMENT) — Pokalspiele sind im deutschen
/// Amateurfußball fachlich üblich und die Ergänzung kostet an dieser
/// Stelle nichts (ein weiterer Enum-Wert, keine zusätzliche Logik). Noch
/// KEINE eigene Competition-/Liga-Entity — siehe
/// docs/PHASE_10_MATCH_FOUNDATION_REPORT.md.
enum MatchType {
  LEAGUE
  FRIENDLY
  TOURNAMENT
  CUP
}

/// Bewusst ein Enum mit drei Werten statt eines booleschen `isHome` —
/// Turniere/Pokalspiele können auf neutralem Platz stattfinden, das lässt
/// sich mit einem Bool nicht sauber abbilden (siehe Auftrag).
enum MatchHomeAway {
  HOME
  AWAY
  NEUTRAL
}

/// Schlanker Lebenszyklus eines Spiels (Phase 10) — bewusst noch kein
/// Live-Spielstatus (z. B. "1. Halbzeit"), keine Workflow-Engine.
enum MatchStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
  COMPLETED
}

/// Welche Seite eines Turnier-KO-Spiels ein `TournamentMatchSlot` beschreibt
/// (Phase 13). Bewusst getrennt von `MatchHomeAway` — dort geht es um die
/// tatsächliche Heim-/Auswärts-/Neutral-Zuordnung eines aufgelösten Spiels,
/// hier nur darum, WELCHE der beiden Fixture-Seiten (home/away) noch auf
/// eine spätere Auflösung wartet.
enum MatchSlotSide {
  HOME
  AWAY
}

/// Woher der Teilnehmer einer noch nicht aufgelösten KO-Spiel-Seite kommen
/// wird (Phase 13). `TEAM`-Quellen sind bewusst NICHT Teil dieses Enums —
/// sie sind sofort auflösbar (der Teilnehmer ist bereits bekannt) und
/// werden direkt in `FootballMatch.home`/`awayParticipantId` gesetzt, ohne
/// einen `TournamentMatchSlot`-Datensatz zu benötigen. Siehe ADR 0010.
enum MatchSlotSourceType {
  GROUP_POSITION
  WINNER_OF_MATCH
  LOSER_OF_MATCH
}

/// Schlanker Lebenszyklus eines Turniers (Phase 11) — bewusst keine
/// komplexe Workflow-Engine, kein automatischer Statuswechsel.
enum TournamentStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Beschreibt nur die geplante Turnierstruktur (Phase 11) — bewusst OHNE
/// jede automatische Logik (Gruppenbildung, Spielplangenerierung,
/// Tabellenberechnung), siehe Auftrag. Optional auf `FootballTournament`,
/// da ein `DRAFT`-Turnier seine Struktur womöglich noch nicht festgelegt
/// hat.
enum TournamentMode {
  GROUPS
  KNOCKOUT
  GROUPS_AND_KNOCKOUT
}

/// Lebenszyklus eines Turnierteilnehmers (Phase 11) — identisches Muster
/// zu `TeamMemberStatus`/`TeamSeasonStatus`: ein Teilnehmer kann sich vor
/// Turnierbeginn zurückziehen, ohne die Zeile zu löschen (an ihr könnten
/// bereits `FootballMatch`-Referenzen hängen).
enum ParticipantStatus {
  ACTIVE
  WITHDRAWN
}

/// Lebenszyklus einer AccountInvitation. Bewusst nur vier Zustände, keine
/// Workflow-Engine — siehe Modellkommentar an AccountInvitation.
enum AccountInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Grobe Kategorisierung eines Kalendereintrags (Phase 18) — siehe
/// Modellkommentar an `Event`. Bewusst ein kleines, stabiles Enum (gleiche
/// Begründung wie `SportType`/`MatchType`): die beiden in
/// docs/database/Database.md genannten Beispiele ("Training oder
/// Besprechung") plus ein Auffangwert, kein offener, frei erweiterbarer
/// Kategorienkatalog.
enum EventType {
  TRAINING
  MEETING
  OTHER
}

// ---------------------------------------------------------------------------
// better-auth-eigene Modelle (generiert via `npx @better-auth/cli generate`,
// siehe packages/auth/src/index.ts). `User` ist um das domänenspezifische
// Feld `status` erweitert (packages/auth: `user.additionalFields`).
//
// Diese vier Modelle sind bewusst NICHT tenant-partitioniert und tragen
// KEIN Row-Level-Security — siehe docs/ARCHITEKTUR_FINALISIERUNG.md,
// Abschnitt 8 ("globale Identitätsebene").
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions                Session[]
  accounts                Account[]
  memberships             Membership[]
  platformRoleAssignments PlatformRoleAssignment[]
  sentInvitations         AccountInvitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Plattformebene (mandantenübergreifend, siehe ADR 0004)
// ---------------------------------------------------------------------------

/// Mandantenübergreifende Plattformrolle, direkt am User — bewusst getrennt
/// von RoleAssignment (Person-basiert, tenant-partitioniert).
model PlatformRoleAssignment {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole
  createdAt DateTime     @default(now())

  @@unique([userId, role])
  @@map("platform_role_assignment")
}

// ---------------------------------------------------------------------------
// Mandantenebene (RLS-geschützt, siehe Migration + docs/ARCHITEKTUR_FINALISIERUNG.md Abschnitt 8)
//
// Ausnahme: `Tenant` selbst trägt keine RLS-Policy — der Tenant ist die
// Wurzel der Mandantenhierarchie, nicht durch seine eigene tenant_id
// gefiltert. Zugriff auf Tenant-Zeilen (z. B. Slug-Lookup beim Login,
// "meine Vereine" über Membership→Person) erfolgt applikationsseitig.
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  departments            Department[]
  persons                Person[]
  roleAssignments        RoleAssignment[]
  personRelationships    PersonRelationship[]
  teams                  Team[]
  teamMembers            TeamMember[]
  accountInvitations     AccountInvitation[]
  seasons                Season[]
  ageGroups              AgeGroup[]
  teamSeasons            TeamSeason[]
  venues                 Venue[]
  footballMatches        FootballMatch[]
  footballTournaments    FootballTournament[]
  tournamentParticipants TournamentParticipant[]
  tournamentVenues       TournamentVenue[]
  tournamentGroups       TournamentGroup[]
  tournamentMatchSlots   TournamentMatchSlot[]
  events                 Event[]

  @@map("tenant")
}

model Department {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  /// Phase 9: grobe Sportart-Klassifizierung — bewusst KEIN
  /// fußballspezifisches Feld (siehe Auftrag: "Department und Team bleiben
  /// generisch"), sondern derselbe generische Klassifizierer, den jede
  /// andere Abteilung auch trägt (Tennis, Radsport, …). Ausschließlich
  /// dieses Feld entscheidet, ob eine `Team` dieser Department eine
  /// `TeamSeason` erhalten darf — siehe TeamSeason-Kommentar.
  sportType SportType @default(OTHER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teams               Team[]
  roleAssignments     RoleAssignment[]
  seasons             Season[]
  footballTournaments FootballTournament[]
  events              Event[]

  @@unique([tenantId, name])
  // Composite-Unique (zusätzlich zum bereits eindeutigen `id`), damit
  // Team/RoleAssignment per Composite-Foreign-Key gegen (tenantId, id)
  // referenzieren können — siehe Kommentar an RoleAssignment weiter unten.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("department")
}

model Team {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "team_tenant_fkey")
  departmentId String
  // Composite FK (tenantId, departmentId) → department(tenantId, id) statt
  // nur (departmentId) → department(id): erzwingt auf DB-Ebene, dass ein
  // Team nur eine Department DESSELBEN Tenants referenzieren kann. Mit nur
  // `departmentId` allein wäre ein Team mit `tenantId=A` referenzierbar auf
  // eine Department mit `tenantId=B` — das ist der gleiche
  // Cross-Tenant-Konsistenzfehler, der für RoleAssignment behoben wurde.
  department   Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roleAssignments RoleAssignment[]
  teamMembers     TeamMember[]
  teamSeasons     TeamSeason[]
  events          Event[]

  @@unique([departmentId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([departmentId])
  @@map("team")
}

/// Vereinsmitglied — mandantenbezogen, existiert unabhängig von einem
/// `User`-Account (z. B. minderjähriges Mitglied ohne eigenen Login).
/// Siehe ADR 0003.
model Person {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  firstName    String
  lastName     String
  birthDate    DateTime?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships             Membership[]
  roleAssignments         RoleAssignment[]     @relation("PersonRoleAssignments")
  grantedRoleAssignments  RoleAssignment[]     @relation("GrantedByPerson")
  relationshipsAsGuardian PersonRelationship[] @relation("RelationshipFromPerson")
  relationshipsAsChild    PersonRelationship[] @relation("RelationshipToPerson")
  verifiedRelationships   PersonRelationship[] @relation("RelationshipVerifiedBy")
  teamMemberships         TeamMember[]         @relation("PersonTeamMemberships")
  accountInvitations      AccountInvitation[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("person")
}

/// Verknüpft einen globalen Login-Account (`User`) mit einer mandantenbezogenen
/// Person ("dieser Login ist diese Person"). Kein Rollenträger, siehe ADR 0003.
///
/// Cross-Tenant-Konsistenz geprüft (Phase 3): `Membership` trägt bewusst
/// KEIN eigenes `tenantId` (globale Identitätsebene, siehe
/// docs/ARCHITEKTUR_FINALISIERUNG.md Abschnitt 8) und hat daher keinen
/// eigenen Tenant-Anspruch, der zu `person.tenantId` inkonsistent werden
/// könnte — ein Composite-FK ist hier weder möglich noch nötig. Die
/// Konsistenz ist strukturell gegeben: welchem Tenant eine Membership
/// "angehört" ergibt sich ausschließlich aus der referenzierten Person.
model Membership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  personId  String           @unique
  person    Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("membership")
}

/// Scope-basierte Rollenzuweisung, siehe ADR 0004 und
/// docs/ARCHITEKTUR_FINALISIERUNG.md Abschnitt 4. Scope-Konsistenz
/// (TENANT ⇒ department/team NULL, DEPARTMENT ⇒ department gesetzt,
/// TEAM ⇒ team gesetzt) wird per CHECK-Constraint in der SQL-Migration
/// erzwungen, da Prisma 6 mehrspaltige CHECK-Constraints nicht deklarativ
/// unterstützt.
///
/// Cross-Tenant-Konsistenz von `personId`/`departmentId`/`teamId` (verhindert,
/// dass eine RoleAssignment mit `tenantId=A` auf eine Person/Department/Team
/// mit `tenantId=B` zeigt) wird NICHT per Trigger, sondern durchgängig per
/// Composite Foreign Key durchgesetzt: `person`/`department`/`team`
/// referenzieren jeweils `(tenantId, id)` statt nur `id`. PostgreSQL wendet
/// dabei MATCH SIMPLE an — ist eine der referenzierenden Spalten NULL (z. B.
/// `departmentId` bei TENANT-Scope), gilt der Constraint automatisch als
/// erfüllt; ist die Spalte gesetzt, muss die referenzierte Zeile exakt
/// dieselbe `tenantId` haben. Siehe docs/PHASE_2_CORE_REPORT.md, Abschnitt
/// 20/21 und docs/PHASE_3_CLUB_STRUCTURE_REPORT.md.
///
/// `grantedByPersonId` bleibt bewusst eine EINFACHE (nicht-composite) FK:
/// es ist ein rein informatives Attributionsfeld ("wer hat das vergeben"),
/// nicht Teil der fachlichen Bedeutung der Zeile — anders als `personId`
/// (wem die Rolle gehört) oder `departmentId`/`teamId` (welcher Scope). Ein
/// Composite-FK wäre hier zusätzlich technisch unsauber: `ON DELETE SetNull`
/// auf einer Composite-FK würde bei Auslösung versuchen, auch das (NOT
/// NULL) `tenantId`-Feld zu leeren, was einen Constraint-Verstoß zur
/// Laufzeit erzeugen würde (von Prisma selbst als Warnung angezeigt).
/// Cross-Tenant-Werte hier werden applikationsseitig ausgeschlossen: der
/// Wert wird ausschließlich serverseitig aus der aktuellen,
/// Tenant-validierten Person des Aufrufers gesetzt, nie aus Client-Input.
model RoleAssignment {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personId     String
  person       Person      @relation("PersonRoleAssignments", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  role         Role
  scopeType    ScopeType
  departmentId String?
  department   Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  teamId       String?
  team         Team?       @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)
  validFrom    DateTime?
  validUntil   DateTime?

  grantedByPersonId String?
  grantedByPerson   Person? @relation("GrantedByPerson", fields: [grantedByPersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Duplicate-Schutz (Phase 5): eine identische aktive Zuweisung (gleiche
  // Person, Rolle, Scope und ggf. Department/Team) darf nicht mehrfach
  // existieren. Nicht als `@@unique` deklarierbar — `departmentId`/`teamId`
  // sind nullable, und SQL behandelt NULL <> NULL, sodass ein normaler
  // Unique-Index zwei TENANT-Scope-Zeilen derselben Person/Rolle (beide mit
  // departmentId=teamId=NULL) NICHT als Duplikat erkennen würde. Stattdessen
  // ein funktionaler Unique-Index mit COALESCE(..., '') in der Migration
  // `20260821_add_role_assignment_uniqueness` (Prisma 6 unterstützt
  // Expression-Indizes nicht deklarativ).
  @@index([tenantId])
  @@index([personId])
  @@index([departmentId])
  @@index([teamId])
  @@map("role_assignment")
}

/// Gerichtete, verifizierungspflichtige Beziehung zwischen zwei Personen
/// desselben Tenants (z. B. Eltern-Kind). KEINE RBAC-Rolle, siehe ADR 0005.
///
/// `fromPerson`/`toPerson` referenzieren `Person` über Composite Foreign Keys
/// `(tenantId, personId) → person(tenantId, id)` — verhindert, dass eine
/// Beziehung tenantübergreifend zwei Personen unterschiedlicher Vereine
/// verknüpft. `verifiedByPersonId` bleibt bewusst eine einfache FK (reines
/// Attributionsfeld, gleiche Begründung wie `RoleAssignment.grantedByPersonId`
/// oben — inklusive derselben `SetNull`-auf-Composite-FK-Problematik).
model PersonRelationship {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromPersonId    String
  fromPerson      Person             @relation("RelationshipFromPerson", fields: [tenantId, fromPersonId], references: [tenantId, id], onDelete: Restrict)
  toPersonId      String
  toPerson        Person             @relation("RelationshipToPerson", fields: [tenantId, toPersonId], references: [tenantId, id], onDelete: Restrict)
  type            RelationshipType
  status          RelationshipStatus @default(PENDING)
  isLegalGuardian Boolean            @default(false)
  validFrom       DateTime?
  validUntil      DateTime?

  verifiedByPersonId String?
  verifiedByPerson   Person? @relation("RelationshipVerifiedBy", fields: [verifiedByPersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromPersonId, toPersonId, type])
  @@index([tenantId])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@map("person_relationship")
}

/// Fachliche Mannschaftszugehörigkeit — "diese Person gehört zu dieser
/// Mannschaft" — und ausdrücklich NICHTS sonst. Drei separate, bewusst
/// nicht vermischte Konzepte im Datenmodell (siehe docs/database/Database.md):
///
///   - `Membership`      = Login-Zuordnung (welcher `User` ist welche `Person`)
///   - `TeamMember`       = fachliche Mannschaftszugehörigkeit (dieses Modell)
///   - `RoleAssignment`   = Berechtigung (was darf diese Person tun)
///
/// Ein Spieler hat nur `TeamMember`. Ein Trainer hat zusätzlich eine
/// `RoleAssignment(role: COACH, scopeType: TEAM, teamId: ...)` — beide
/// Zeilen existieren unabhängig voneinander; das Entfernen der einen
/// berührt die andere nicht.
///
/// Namensentscheidung: nicht `TeamMembership`, obwohl das Arbeitspaket
/// diesen Namen als Arbeitsbezeichnung vorschlug. `TeamMembership` würde im
/// selben Schema neben dem bereits existierenden, semantisch komplett
/// anderen `Membership`-Modell (Login-Bindung, siehe oben) stehen — beide
/// mit identischem "-ship"-Suffix, beide potenziell in denselben
/// Log-Zeilen/Fehlermeldungen/Code-Reviews auftauchend. Genau diese
/// Verwechslungsgefahr sollte laut Auftrag ausgeschlossen werden.
/// `TeamAssignment` wurde ebenfalls verworfen: `RoleAssignment` deckt
/// bereits `scopeType: TEAM` ab, ein `TeamAssignment` läge fachlich
/// gefährlich nah an "RoleAssignment mit Team-Scope". `TeamMember` trägt
/// keines der beiden kollidierenden Suffixe, liest sich als das, was es
/// ist (ein Eintrag im Kader einer Mannschaft), und deckt sich mit der im
/// Auftrag bereits vorgegebenen REST-Vokabel `/teams/:teamId/members`.
///
/// Cross-Tenant-Konsistenz nach demselben Muster wie RoleAssignment/
/// PersonRelationship (Phase 3): `person`/`team` referenzieren jeweils
/// `(tenantId, id)` statt nur `id` (Composite FK, PostgreSQL MATCH SIMPLE).
///
/// `status` (ACTIVE/INACTIVE) statt Hard-Delete: `DELETE
/// /api/v1/teams/:teamId/members/:personId` setzt `status = INACTIVE`
/// statt die Zeile zu löschen — damit bleibt nachvollziehbar, dass eine
/// Person einmal Teil der Mannschaft war (z. B. Spieler, der die Mannschaft
/// mitten in der Saison verlässt), ohne eine vollständige
/// Historisierung (validFrom/validUntil, Audit-Log) einzuführen. Die
/// Unique-Regel "keine doppelte AKTIVE Zuordnung derselben Person zur
/// selben Mannschaft" ist deshalb ein PARTIELLER Unique-Index nur auf
/// `status = 'ACTIVE'` (Prisma 6 unterstützt partielle Indizes nicht
/// deklarativ — siehe SQL-Migration) statt eines einfachen
/// `@@unique([personId, teamId])`, sonst könnte eine einmal inaktive
/// Person nie wieder derselben Mannschaft hinzugefügt werden.
model TeamMember {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personId  String
  person    Person           @relation("PersonTeamMemberships", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  teamId    String
  team      Team             @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)
  status    TeamMemberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
  @@index([personId])
  @@index([teamId])
  @@map("team_member")
}

/// Account-Einladung (Phase 6): "lade diese Person zu einem Login-Account
/// ein" — der einzige Weg, wie eine `Person` erstmals mit einem `User`
/// verknüpft wird (über eine `Membership`, sobald die Einladung akzeptiert
/// wurde). Bewusst eine eigene Entity statt eines Felds an `Person`: der
/// Lebenszyklus (Token, Ablauf, mehrere Einladungsversuche über die Zeit)
/// hat nichts mit der fachlichen Bedeutung von `Person` zu tun.
///
/// Sicherheit: Es wird ausschließlich `tokenHash` gespeichert, niemals der
/// rohe Token (siehe `apps/api/src/invitations/invitations.service.ts` —
/// `crypto.randomBytes` + `crypto.createHash('sha256')`, keine
/// selbstgebaute Kryptographie). Der rohe Token existiert nur einmalig im
/// Response-Body der Erstellung bzw. im E-Mail-Text — nie in Logs, nie in
/// Fehlermeldungen.
///
/// `email` ist bewusst auf der Einladung gespeichert (nicht nur auf
/// `Person.contactEmail`, das optional/veränderlich ist) — die Einladung
/// bindet sich an eine konkrete Adresse zum Einladungszeitpunkt; beim
/// Akzeptieren wird geprüft, dass die eingeloggte Session exakt zu dieser
/// Adresse gehört (siehe Service).
///
/// Höchstens eine PENDING-Einladung pro Person gleichzeitig — partieller
/// Unique-Index in der Migration (Prisma 6 unterstützt WHERE-Klauseln in
/// `@@unique` nicht deklarativ, siehe TeamMember für dasselbe Muster).
/// Ein erneutes Versenden widerruft die vorherige PENDING-Einladung
/// (macht ihren Token ungültig) statt eine zweite parallel gültige zu
/// erzeugen.
///
/// BEWUSST OHNE Row-Level-Security (anders als die übrigen tenant-
/// gebundenen Tabellen) — exakt derselbe Grund wie bei `Tenant` (siehe
/// dort): der öffentliche Annahme-Flow (`GET /api/v1/invitations/:token`,
/// `POST /api/v1/invitations/accept`) kennt den Tenant naturgemäß noch
/// NICHT — er wird über den Token erst ermittelt, ein klassisches
/// Henne-Ei-Problem für tenant-kontext-basiertes RLS. Die Sicherheits-
/// grenze hier ist nicht die Tenant-Zugehörigkeit, sondern der Besitz des
/// rohen Tokens (256 Bit Entropie, siehe `tokenHash`) — funktional
/// äquivalent zu jedem Passwort-Reset-Link-Muster. Alle verwaltenden
/// Operationen (anlegen/auflisten/widerrufen durch TENANT_ADMIN) filtern
/// dennoch explizit nach `tenantId` in `InvitationsService` (Application-
/// Layer-Schutz, auch ohne DB-erzwungenes RLS) und laufen weiterhin über
/// `getTenantPrisma` für die dabei mitbenötigten RLS-geschützten
/// `Person`-Zugriffe. Die Composite-FK `(tenantId, personId) →
/// person(tenantId, id)` bleibt bestehen — verhindert weiterhin auf
/// DB-Ebene, dass eine Einladung eine Person eines anderen Tenants
/// referenziert, unabhängig von RLS.
model AccountInvitation {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personId        String
  person          Person                  @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  email           String
  tokenHash       String                  @unique
  status          AccountInvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  invitedByUser   User                    @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedAt      DateTime?
  createdAt       DateTime                @default(now())

  @@index([tenantId])
  @@index([personId])
  @@index([email])
  @@map("account_invitation")
}

/// Saison einer Abteilung (Phase 9) — bewusst sportartenübergreifend
/// generisch modelliert (kein Teil eines "Football-Moduls"), da Saisons
/// fachlich für jede Abteilung sinnvoll sind (eine Tennis-Saison ist
/// genauso denkbar wie eine Fußball-Saison) — siehe
/// docs/PHASE_9_FOOTBALL_SEASON_REPORT.md, Abschnitt "Season-Modell".
///
/// Höchstens eine ACTIVE Season pro Department gleichzeitig — partieller
/// Unique-Index in der Migration (gleiches Muster wie TeamMember/
/// AccountInvitation, siehe dort: Prisma 6 bildet WHERE-Klauseln in
/// `@@unique` nicht deklarativ ab). `startsAt < endsAt` wird per
/// CHECK-Constraint in derselben Migration erzwungen. Überschneidende
/// Zeiträume zwischen PLANNED/ACTIVE/COMPLETED Saisons werden bewusst
/// NICHT verboten (siehe Auftrag: legitime Übergänge, z. B. Vorbereitung
/// der nächsten Saison während die aktuelle noch läuft).
model Season {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departmentId String
  // Composite FK (tenantId, departmentId) → department(tenantId, id),
  // gleiches Muster wie Team → Department (siehe dort).
  department   Department   @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  name         String
  startsAt     DateTime
  endsAt       DateTime
  status       SeasonStatus @default(PLANNED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  teamSeasons         TeamSeason[]
  footballTournaments FootballTournament[]
  events              Event[]

  @@unique([departmentId, name])
  @@unique([tenantId, id])
  // Ergänzt in Phase 11 als Composite-Unique-Ziel für
  // FootballTournament.seasonId — erzwingt, dass ein referenziertes
  // Turnier tatsächlich zur selben Department gehört wie die Season.
  @@unique([tenantId, departmentId, id])
  @@index([tenantId])
  @@index([departmentId])
  @@map("season")
}

/// Konfigurierbare Altersklasse (Phase 9) — bewusst eine Entity statt
/// eines Enums mit hartcodierten deutschen Jugendklassen (G-/F-/E-/D-/C-/
/// B-/A-Jugend), siehe docs/PHASE_9_FOOTBALL_SEASON_REPORT.md, Abschnitt
/// "Altersklassen": ein Enum würde die Plattform dauerhaft an ein
/// deutsches Jugendfußball-Schema binden und spätere andere Verbände,
/// Länder oder reine Erwachsenenkategorien erschweren. Tenant-weit statt
/// department-gebunden modelliert — eine Altersklasse wie "Herren" ist
/// grundsätzlich nicht zwangsläufig fußballspezifisch, auch wenn sie
/// aktuell ausschließlich über TeamSeason (Fußball) verwendet wird.
/// Noch kein DELETE-Endpoint, solange Verwendungs-/Archivierungsregeln
/// nicht geklärt sind (siehe Auftrag).
model AgeGroup {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons TeamSeason[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("age_group")
}

/// Saisonale Zuordnung eines bestehenden `Team` zu einer `Season` +
/// `AgeGroup` (Phase 9). Das `Team` selbst bleibt die dauerhafte
/// organisatorische Identität über Saisons hinweg — ein real existierender
/// Verein führt eine Kaderbezeichnung wie "E1" typischerweise über Jahre
/// fort, auch wenn sich Altersklasse und Spieler von Saison zu Saison
/// ändern (die Spieler "wachsen durch" die Altersklassen, der
/// Mannschafts-Slot "E1" bleibt bestehen). Ein alternatives Modell (jede
/// Saison ein komplett neues `Team`) wurde bewusst verworfen: es würde
/// RoleAssignments/TeamMember/Rollenverlauf pro Saison neu verknüpfen
/// müssen, ohne einen fachlichen Vorteil zu bieten — siehe
/// docs/PHASE_9_FOOTBALL_SEASON_REPORT.md, Abschnitt "Team vs.
/// TeamSeason" für die ausführliche Begründung.
///
/// `team.name` bleibt die dauerhafte organisatorische Bezeichnung;
/// `displayName` ist eine optionale, rein saisonale Anzeige-Überschreibung
/// (z. B. falls ein Verein "E1" in einer Saison anders benennen möchte),
/// keine Datenverdopplung im Regelfall (NULL, wenn ungenutzt).
///
/// Bewusst NICHT auf Datenbankebene erzwungen, dass `team.department`
/// tatsächlich `sportType = FOOTBALL` ist — dafür wäre ein Trigger nötig,
/// der beim Schreiben von `team_season` die `department`-Tabelle über
/// `team` hinweg nachschlägt, was in reinem SQL/Postgres-Constraints ohne
/// eigene Trigger-Funktion nicht ausdrückbar ist. Für den aktuellen Umfang
/// unverhältnismäßige Komplexität (siehe Auftrag: "sofern DB-seitig
/// sinnvoll möglich"). Stattdessen anwendungsseitig in
/// `TeamSeasonsService.create()` geprüft (klare Fehlermeldung statt
/// stillem Fehlverhalten) und durch einen dedizierten Test abgesichert.
model TeamSeason {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teamId      String
  team        Team             @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)
  seasonId    String
  season      Season           @relation(fields: [tenantId, seasonId], references: [tenantId, id], onDelete: Restrict)
  ageGroupId  String
  ageGroup    AgeGroup         @relation(fields: [tenantId, ageGroupId], references: [tenantId, id], onDelete: Restrict)
  displayName String?
  status      TeamSeasonStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  footballMatches        FootballMatch[]
  tournamentParticipants TournamentParticipant[]

  @@unique([teamId, seasonId])
  // Ergänzt in Phase 10: Composite-Unique-Ziel für FootballMatch.teamSeasonId
  // (gleiches Muster wie bei Department/Team/Season/AgeGroup oben) — ohne
  // dieses Zusatz-Unique kann FootballMatch nicht per Composite-FK
  // (tenantId, teamSeasonId) → team_season(tenantId, id) referenzieren.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([teamId])
  @@index([seasonId])
  @@index([ageGroupId])
  @@map("team_season")
}

/// Spielstätte (Phase 10) — bewusst sportartenübergreifend und NICHT an
/// eine Fußball-Abteilung gekoppelt (siehe Auftrag: "Venue soll
/// sportartenübergreifend verwendbar sein"), tenant-gebundenes
/// Stammdatenmodell analog zu `AgeGroup`. Keine Google-Maps-/Geocoding-
/// Abhängigkeit — `latitude`/`longitude` sind rein optionale, manuell
/// gepflegte Koordinatenfelder ohne Validierung gegen einen externen
/// Dienst.
///
/// Modellierungsentscheidung "Venue vs. Venue+Pitch/Court" (Auftrag
/// Abschnitt 7): für den MVP ist jede konkrete Spielfläche ein eigener
/// `Venue`-Datensatz (Option A) — z. B. "Sportzentrum Benediktbeuern —
/// Hauptplatz" und "Sportzentrum Benediktbeuern — Nebenplatz" als zwei
/// separate Zeilen mit ähnlichem `name`-Präfix, statt einer eigenen
/// Pitch/Court-Unterstruktur. Begründung: die zusätzliche Hierarchieebene
/// (Standort → mehrere Plätze) hat für den aktuellen Funktionsumfang
/// keinen fachlichen Mehrwert (nichts referenziert "den Standort als
/// Ganzes", nur konkrete Spielflächen), und eine spätere Erweiterung
/// bleibt ohne Breaking Change möglich: ein optionales, selbstreferenzierendes
/// `parentVenueId`-Feld (oder alternativ eine eigene `Pitch`-Entity, die
/// auf `Venue` als "Standort" zeigt) ließe sich additiv ergänzen, ohne
/// bestehende `Venue`-Zeilen oder `FootballMatch.venueId`-Referenzen zu
/// brechen.
model Venue {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  street      String?
  postalCode  String?
  city        String?
  countryCode String?
  latitude    Float?
  longitude   Float?
  notes       String?
  status      VenueStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  footballMatches  FootballMatch[]
  tournamentVenues TournamentVenue[]
  events           Event[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("venue")
}

/// Spielgrundmodell (Phase 10) — Namensentscheidung `FootballMatch` (nicht
/// sportartenübergreifend generisch `Match`/`Game`/`Fixture`): die
/// fachlichen Unterschiede zwischen Sportarten (z. B. Ergebnisdarstellung:
/// Tore vs. Sätze, Unentschieden möglich oder nicht) sind aktuell zu groß/
/// unklar für ein tragfähiges gemeinsames Basismodell — ein verfrühtes
/// universelles Modell würde entweder Football-Felder für Tennis/
/// Stockschützen mitschleppen oder eine unnötig abstrakte
/// Attribut-Bag-Struktur erzwingen. `FootballMatch` ist laut Auftrag
/// "vollkommen akzeptabel", solange der spätere Turnierplaner UND der
/// normale Fußball-Spielbetrieb dasselbe Modell verwenden — genau das ist
/// hier sichergestellt: ein künftiges `TournamentMatch` referenziert
/// perspektivisch denselben `FootballMatch`-Datensatz (oder eine
/// Turnier-spezifische Zuordnung DARAUF), es entsteht kein paralleles
/// zweites Spielmodell.
///
/// `Match` statt `Game`/`Fixture` als Namensbestandteil: "Match" ist
/// international über Sportarten hinweg verständlich (Fußball, Tennis,
/// Handball, …), technisch unbelastet in diesem Codebase, und
/// unmissverständlicher als "Game" (zu generisch, keine Sport-Konnotation)
/// oder "Fixture" (primär britisches Fußball-/Sportenglisch, im
/// internationalen/deutschen Kontext weniger sofort verständlich).
///
/// KEIN redundantes `seasonId`-Feld (siehe Auftrag Abschnitt 19): die
/// Saison ist über `teamSeasonId` → `TeamSeason.seasonId` bereits
/// eindeutig ableitbar. Eine zusätzliche `seasonId`-Spalte hätte entweder
/// eine eigene Konsistenzprüfung (Trigger, der bei jedem INSERT/UPDATE
/// beide Werte gegeneinander abgleicht) oder ein stillschweigendes
/// Inkonsistenzrisiko benötigt — ohne klaren fachlichen Vorteil gegenüber
/// dem einfachen Join über `teamSeasonId`. API-Filter `?seasonId=` wird
/// über eine Relations-Query auf `teamSeason.seasonId` umgesetzt (siehe
/// `MatchesService`), nicht über eine eigene Spalte.
///
/// Fußball-only ist hier STRUKTURELL, nicht durch eine eigene Prüfung
/// erzwungen: `teamSeasonId` referenziert ausschließlich `TeamSeason`-
/// Zeilen, deren zugrundeliegendes `Team` bereits beim Anlegen der
/// `TeamSeason` selbst auf `department.sportType = FOOTBALL` geprüft
/// wurde (siehe `TeamSeasonsService.create()`, Phase 9) — ein
/// `FootballMatch` kann also gar nicht auf eine Nicht-Fußball-Mannschaft
/// zeigen, ohne dass hier ein zusätzlicher Guardrail nötig wäre.
///
/// Gegner-Modellierung (Auftrag Abschnitt 13): bewusst nur `opponentName`
/// (Freitext) im MVP — der Gegner ist im Regelfall kein Verevia-Mandant
/// und eine vollständige Club-/ExternalTeam-Datenbank ist ausdrücklich
/// nicht Teil dieser Phase. Dokumentierter künftiger Erweiterungspunkt für
/// den Turnierplaner: ein leichtes `Opponent`/`Participant`-Modell, das
/// sowohl auf eine eigene `TeamSeason` (Spiel zwischen zwei eigenen
/// Mannschaften) als auch auf einen externen, noch zu modellierenden
/// Club/Team verweisen kann, würde `opponentName` perspektivisch als
/// Fallback-Freitext ablösen bzw. ergänzen — nicht Teil von Phase 10.
///
/// Ergebnis: `homeScore`/`awayScore` bewusst bereits im Grundmodell (siehe
/// Auftrag Abschnitt 17), aber ausdrücklich OHNE Statistiken/Torschützen/
/// Karten/Aufstellungen. Ein CHECK-Constraint in der Migration erzwingt,
/// dass beide Felder nur gesetzt sein dürfen, wenn `status = COMPLETED`
/// ist (kein fragiler Trigger nötig — ein einfacher spaltenbasierter
/// CHECK reicht).
///
/// Phase 11 (ADR 0008): `teamSeasonId`/`opponentName` (Vereinsmatch-Modus)
/// und `tournamentId`+`homeParticipantId`+`awayParticipantId`
/// (Turniermatch-Modus, optional `tournamentGroupId`) sind zwei sich
/// gegenseitig ausschließende Belegungen derselben Zeile, per CHECK
/// erzwungen (`football_match_mode_consistency`) — siehe ADR für die
/// ausführliche Begründung gegen ein paralleles Turnierspiel-Modell.
model FootballMatch {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Vereinsmatch-Modus (Phase 10, unverändert) — NULL im Turniermatch-Modus.
  teamSeasonId String?
  // Composite FK (tenantId, teamSeasonId) → team_season(tenantId, id) —
  // gleiches Cross-Tenant-Konsistenzmuster wie überall sonst im Schema.
  teamSeason   TeamSeason?   @relation(fields: [tenantId, teamSeasonId], references: [tenantId, id], onDelete: Restrict)
  opponentName String?
  venueId      String?
  venue        Venue?        @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Restrict)
  startsAt     DateTime
  type         MatchType
  status       MatchStatus   @default(SCHEDULED)
  homeAway     MatchHomeAway
  homeScore    Int?
  awayScore    Int?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Phase 14: gesetzt, sobald dieses Spiel (als Quelle eines
  // WINNER_OF_MATCH/LOSER_OF_MATCH-Slots) mindestens einen abhängigen
  // TournamentMatchSlot aufgelöst hat. Der Slot-Datensatz selbst wird bei
  // Auflösung gelöscht (siehe TournamentMatchSlot) — ohne dieses Feld gäbe
  // es danach keine durable Spur mehr davon, dass bereits propagiert wurde.
  // Sobald gesetzt, sind status/homeScore/awayScore dieses Spiels über die
  // Ergebnis-API unveränderlich (siehe ADR 0011) — verhindert stille
  // Inkonsistenzen zwischen einem nachträglich korrigierten Ergebnis und
  // bereits weitergegebenen Teilnehmern in Folgespielen.
  resultPropagatedAt DateTime?

  // Turniermatch-Modus (Phase 11, ADR 0008) — alle vier NULL im
  // Vereinsmatch-Modus. `tournamentGroupId`/`home`/`awayParticipantId`
  // referenzieren jeweils über (tenantId, tournamentId, X) — das
  // zusätzliche Drei-Spalten-Unique auf TournamentGroup/TournamentParticipant
  // erzwingt damit strukturell, dass Gruppe und Teilnehmer tatsächlich zu
  // GENAU diesem Turnier gehören, ohne eigenen Trigger.
  //
  // Seit Phase 13 (ADR 0010) dürfen `homeParticipantId`/`awayParticipantId`
  // im Turniermatch-Modus zusätzlich BEIDE oder EINZELN NULL sein — für ein
  // KO-Spiel, dessen Teilnehmer noch nicht feststeht (z. B. "Sieger
  // Halbfinale 1"). Die gelockerte `football_match_mode_consistency`-CHECK
  // erlaubt das; welche Seite auf welche Weise noch aufzulösen ist, steht
  // dann in einem zugehörigen `TournamentMatchSlot`-Datensatz (siehe dort).
  tournamentId      String?
  tournament        FootballTournament?    @relation(fields: [tenantId, tournamentId], references: [tenantId, id], onDelete: Restrict)
  tournamentGroupId String?
  tournamentGroup   TournamentGroup?       @relation(fields: [tenantId, tournamentId, tournamentGroupId], references: [tenantId, tournamentId, id], onDelete: Restrict)
  homeParticipantId String?
  homeParticipant   TournamentParticipant? @relation("HomeParticipant", fields: [tenantId, tournamentId, homeParticipantId], references: [tenantId, tournamentId, id], onDelete: Restrict)
  awayParticipantId String?
  awayParticipant   TournamentParticipant? @relation("AwayParticipant", fields: [tenantId, tournamentId, awayParticipantId], references: [tenantId, tournamentId, id], onDelete: Restrict)

  slotsAsOwner  TournamentMatchSlot[] @relation("MatchSlotOwner")
  slotsAsSource TournamentMatchSlot[] @relation("MatchSlotSource")

  @@unique([tenantId, tournamentId, id])
  @@index([tenantId])
  @@index([teamSeasonId])
  @@index([venueId])
  @@index([startsAt])
  @@index([tournamentId])
  @@index([tournamentGroupId])
  @@index([homeParticipantId])
  @@index([awayParticipantId])
  @@map("football_match")
}

/// Fußball-Turnier (Phase 11) — bewusst `FootballTournament` (nicht
/// sportneutral `Tournament`), analog zur `FootballMatch`-Entscheidung aus
/// Phase 10: die fachlichen Unterschiede zwischen Sportarten sind für ein
/// gemeinsames Turniermodell noch zu groß/unklar. `departmentId`
/// verpflichtend (ein Turnier gehört immer zu genau einer Abteilung),
/// anwendungsseitig auf `sportType: FOOTBALL` geprüft (gleiches Muster wie
/// `TeamSeasonsService.create()`, Phase 9) — kein DB-Trigger, siehe dort
/// für die Begründung.
///
/// `seasonId` bewusst OPTIONAL: ein Turnier muss nicht zwingend einer
/// laufenden Saison zugeordnet sein — z. B. ein Sommerturnier zwischen
/// zwei Saisons, oder das allererste Turnier eines Vereins, bevor
/// überhaupt eine `Season` angelegt wurde. Eine Pflichtzuordnung hätte
/// Organisatoren gezwungen, für rein saisonunabhängige Events eine
/// künstliche Platzhalter-Saison anzulegen. Falls gesetzt, muss die
/// Season zur selben Abteilung gehören wie das Turnier — durchgesetzt per
/// Composite-FK `(tenantId, departmentId, seasonId)` gegen ein
/// zusätzliches Drei-Spalten-Unique auf `Season`.
///
/// `mode` ebenfalls optional (ein frisches `DRAFT`-Turnier hat seine
/// Struktur womöglich noch nicht festgelegt) und rein beschreibend — keine
/// automatische Logik daran geknüpft (siehe Auftrag: "noch keine
/// automatische Logik implementieren").
model FootballTournament {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departmentId String
  department   Department       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  seasonId     String?
  // Composite FK über (tenantId, departmentId, seasonId) statt nur
  // (tenantId, seasonId) — erzwingt zusätzlich auf DB-Ebene, dass die
  // referenzierte Season zur selben Department gehört wie das Turnier.
  season       Season?          @relation(fields: [tenantId, departmentId, seasonId], references: [tenantId, departmentId, id], onDelete: Restrict)
  name         String
  description  String?
  startsAt     DateTime
  endsAt       DateTime?
  status       TournamentStatus @default(DRAFT)
  mode         TournamentMode?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  participants TournamentParticipant[]
  venues       TournamentVenue[]
  groups       TournamentGroup[]
  matches      FootballMatch[]
  matchSlots   TournamentMatchSlot[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([departmentId])
  @@index([seasonId])
  @@map("football_tournament")
}

/// Teilnehmer eines Turniers (Phase 11) — entweder eine interne
/// `TeamSeason` desselben Tenants ODER ein externer Freitextname, nie
/// beides, nie keines (CHECK `tournament_participant_source_xor`). Siehe
/// ADR 0008 für die Begründung, warum `FootballMatch` selbst nicht
/// zwischen intern/extern unterscheiden muss — das übernimmt allein diese
/// Entity.
///
/// Bewusst KEINE vollständige externe Club-/Team-Datenbank — `externalName`
/// ist reiner Freitext für den MVP. Dokumentierter künftiger
/// Erweiterungspunkt: ein `externalClubName`-Feld oder ein eigenes,
/// leichtes External-Club-Verzeichnis, falls wiederkehrende externe
/// Gastmannschaften über mehrere Turniere hinweg wiedererkannt werden
/// sollen — nicht Teil dieser Phase.
///
/// Duplikatschutz: dieselbe interne `TeamSeason` darf pro Turnier nur
/// einmal Teilnehmer sein (partieller Unique-Index). Für externe Namen
/// case-insensitive Duplikatprüfung (funktionaler partieller Unique-Index
/// auf `lower(externalName)`) — Prisma 6 bildet weder WHERE-Klauseln noch
/// Ausdrucks-Indizes deklarativ ab, siehe SQL-Migration.
model TournamentParticipant {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tournamentId String
  tournament   FootballTournament @relation(fields: [tenantId, tournamentId], references: [tenantId, id], onDelete: Restrict)
  teamSeasonId String?
  // Composite FK (tenantId, teamSeasonId) → team_season(tenantId, id).
  teamSeason   TeamSeason?        @relation(fields: [tenantId, teamSeasonId], references: [tenantId, id], onDelete: Restrict)
  externalName String?
  groupId      String?
  // Composite FK über (tenantId, tournamentId, groupId) — erzwingt, dass
  // die Gruppe zu GENAU diesem Turnier gehört (gleiches Muster wie am
  // FootballMatch, siehe ADR 0008). Bewusst `onDelete: Restrict`, NICHT
  // `SetNull`: bei einer Composite-FK, deren Nicht-`groupId`-Spalten
  // (`tenantId`, `tournamentId`) selbst NOT NULL sind, würde `SetNull`
  // versuchen, ALLE FK-Spalten zu leeren — inklusive der Pflichtfelder —
  // und liefe zur Laufzeit auf einen NOT-NULL-Constraint-Verstoß hinaus.
  // `Restrict` ist hier ohnehin fachlich richtig: eine Gruppe, der noch
  // Teilnehmer zugeordnet sind, darf nicht gelöscht werden.
  group        TournamentGroup?   @relation(fields: [tenantId, tournamentId, groupId], references: [tenantId, tournamentId, id], onDelete: Restrict)
  status       ParticipantStatus  @default(ACTIVE)
  seed         Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  homeMatches FootballMatch[] @relation("HomeParticipant")
  awayMatches FootballMatch[] @relation("AwayParticipant")

  // Drei-Spalten-Unique — Composite-FK-Ziel für FootballMatch.home/awayParticipantId
  // (siehe ADR 0008) und für TournamentGroupParticipant-artige Referenzen.
  @@unique([tenantId, tournamentId, id])
  @@index([tenantId])
  @@index([tournamentId])
  @@index([teamSeasonId])
  @@index([groupId])
  @@map("tournament_participant")
}

/// Zuordnung einer bestehenden `Venue` zu einem Turnier (Phase 11) — die
/// Phase-10-Entscheidung "jede konkrete Spielfläche ist eine eigene
/// `Venue`" bleibt verbindlich, kein neues Pitch-/Field-Untermodell. Ein
/// Turnier kann mehrere Venues nutzen (z. B. Haupt-/Nebenplatz).
/// `label` ist eine optionale, rein turnierbezogene Anzeige-Überschreibung
/// (z. B. "Feld 1"), OHNE `venue.name` zu duplizieren (NULL im Regelfall).
model TournamentVenue {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tournamentId String
  tournament   FootballTournament @relation(fields: [tenantId, tournamentId], references: [tenantId, id], onDelete: Restrict)
  venueId      String
  venue        Venue              @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Restrict)
  displayOrder Int                @default(0)
  label        String?
  createdAt    DateTime           @default(now())

  @@unique([tournamentId, venueId])
  @@index([tenantId])
  @@index([tournamentId])
  @@index([venueId])
  @@map("tournament_venue")
}

/// Gruppe innerhalb eines Turniers (Phase 11), z. B. "Gruppe A". Rein
/// manuell angelegt und befüllt — keine automatische Gruppenauslosung
/// (nicht Teil dieser Phase). Teilnehmer werden über
/// `TournamentParticipant.groupId` zugeordnet (siehe dort) — bewusst
/// KEINE eigene Zuordnungstabelle, da ein Teilnehmer fachlich höchstens
/// einer Gruppe angehört (K.-o.-only-Teilnehmer bleiben mit `groupId:
/// NULL` gruppenlos) — eine zusätzliche Join-Tabelle wäre für dieses
/// 1:n-Verhältnis unnötige Komplexität.
model TournamentGroup {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tournamentId String
  tournament   FootballTournament @relation(fields: [tenantId, tournamentId], references: [tenantId, id], onDelete: Restrict)
  name         String
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  participants TournamentParticipant[]
  matches      FootballMatch[]
  matchSlots   TournamentMatchSlot[]

  // Drei-Spalten-Unique — Composite-FK-Ziel für FootballMatch.tournamentGroupId
  // und TournamentParticipant.groupId (siehe ADR 0008).
  @@unique([tenantId, tournamentId, id])
  @@unique([tournamentId, name])
  @@index([tenantId])
  @@index([tournamentId])
  @@map("tournament_group")
}

/// Beschreibt, woher der Heim- oder Auswärts-Teilnehmer einer noch nicht
/// aufgelösten KO-Spiel-Seite kommen wird (Phase 13) — z. B. "Sieger
/// Halbfinale 1" (`WINNER_OF_MATCH`, `sourceMatchId` = SF-1) oder "Gruppe A,
/// Platz 2" (`GROUP_POSITION`, `groupId` = Gruppe A, `groupPosition` = 2).
/// Existiert NUR für Seiten ohne bereits bekannten `TournamentParticipant`
/// — direkte Team-Quellen brauchen keine Zeile hier, siehe
/// `MatchSlotSourceType`. Phase 13 löst diese Quellen noch nicht auf (keine
/// Live-Ergebnisverarbeitung, siehe Auftrag Abschnitt 28) — die Struktur
/// verliert die Information dabei aber nicht. Ausführliche Begründung:
/// [ADR 0010](../../../docs/architecture/adr/0010-knockout-pending-match-slots.md).
model TournamentMatchSlot {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tournamentId String
  tournament   FootballTournament @relation(fields: [tenantId, tournamentId], references: [tenantId, id], onDelete: Restrict)

  matchId String
  // Composite FK über (tenantId, tournamentId, matchId) — erzwingt, dass
  // das Spiel, zu dem dieser Slot gehört, tatsächlich zu GENAU diesem
  // Turnier gehört (gleiches Composite-FK-Muster wie ADR 0008).
  match   FootballMatch @relation("MatchSlotOwner", fields: [tenantId, tournamentId, matchId], references: [tenantId, tournamentId, id], onDelete: Cascade)

  side       MatchSlotSide
  sourceType MatchSlotSourceType

  // Nur bei sourceType = GROUP_POSITION gesetzt. groupPosition ist 1-basiert
  // (1 = Gruppenerster). Composite FK erzwingt dieselbe Turnierzugehörigkeit.
  groupId       String?
  group         TournamentGroup? @relation(fields: [tenantId, tournamentId, groupId], references: [tenantId, tournamentId, id], onDelete: Restrict)
  groupPosition Int?

  // Nur bei sourceType = WINNER_OF_MATCH / LOSER_OF_MATCH gesetzt — auch
  // hier über (tenantId, tournamentId, sourceMatchId), erzwingt dieselbe
  // Turnierzugehörigkeit für das referenzierte Vorgängerspiel. Bewusst
  // `onDelete: Restrict` (kein `SetNull`) — dieselbe Begründung wie bei
  // `TournamentParticipant.group` (ADR 0008): `tenantId`/`tournamentId`
  // sind Teil dieser Composite-FK und selbst NOT NULL, `SetNull` würde also
  // versuchen, auch sie zu leeren.
  sourceMatchId String?
  sourceMatch   FootballMatch? @relation("MatchSlotSource", fields: [tenantId, tournamentId, sourceMatchId], references: [tenantId, tournamentId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([tenantId, matchId, side])
  @@index([tenantId])
  @@index([tournamentId])
  @@index([matchId])
  @@index([groupId])
  @@index([sourceMatchId])
  @@map("tournament_match_slot")
}

/// Kalendereintrag (Phase 18) — siehe docs/database/Database.md, Entität
/// "Event (Termin)": "Ein Kalendereintrag, z. B. Training oder
/// Besprechung." Bewusst sportneutral und nicht unter `football/`
/// modelliert (gleiches Muster wie `Venue`, Phase 10) — ein Termin ist
/// kein fußballspezifisches Konzept.
///
/// Gehört zu genau einem `Team` ODER genau einer `Department`, nie beides,
/// nie keines — CHECK-Constraint `event_scope_xor` in der Migration,
/// identisches Muster zu `TournamentParticipant.teamSeasonId`/
/// `externalName` (ADR 0008). Ein team-gebundener Termin (z. B. Training)
/// ist eine alltägliche Trainer-Aufgabe (siehe
/// docs/product/Roles-and-Permissions.md, Phase-10-Ergänzung zu
/// `FootballMatch`) — die Autorisierung folgt deshalb bewusst demselben
/// Muster wie `FootballMatch`/`canOnMatch`, nicht dem administrativeren
/// `canOnTeam`/`canOnSeason`-Muster von `TeamSeason`/`FootballTournament`.
/// Ein department-gebundener Termin (z. B. eine Abteilungsversammlung)
/// folgt hingegen `canOnSeason` (DEPARTMENT_ADMIN verwaltet, jede Rolle in
/// dieser Abteilung liest) — siehe `EventsService`.
///
/// `seasonId`/`venueId` sind optional (Database.md: "optional zu einer
/// Season und einem Venue"). Bewusst KEINE Datenbank-Erzwingung, dass eine
/// gesetzte `Season` tatsächlich zur selben Department gehört wie das
/// Event (Team-gebundene Events hätten dafür einen Join über `Team` hinweg
/// nötig, den reine Postgres-CHECK-Constraints nicht ausdrücken können) —
/// stattdessen anwendungsseitig in `EventsService.create()` geprüft,
/// gleiche Begründung wie bei `TeamSeason` (siehe dortiger Kommentar).
///
/// Bewusst OHNE `Attendance`/`Task`/`Notification` — jeweils eigenständige,
/// weiterhin nicht implementierte Entitäten (Database.md), nicht Teil
/// dieser Phase (siehe PHASE_18-Bericht, "Bewusst nicht im Scope").
model Event {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  departmentId String?
  // Composite FK (tenantId, departmentId) → department(tenantId, id) —
  // gleiches Cross-Tenant-Konsistenzmuster wie überall sonst im Schema.
  department   Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)

  teamId String?
  team   Team?   @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)

  seasonId String?
  season   Season? @relation(fields: [tenantId, seasonId], references: [tenantId, id], onDelete: Restrict)

  venueId String?
  venue   Venue?  @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Restrict)

  title       String
  description String?
  type        EventType @default(OTHER)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([departmentId])
  @@index([teamId])
  @@index([seasonId])
  @@index([venueId])
  @@map("event")
}
