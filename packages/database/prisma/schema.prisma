// Verevia — Core-Datenmodell (Phase 2)
//
// Technisches Fundament für Multi-Tenancy/Identity/RBAC, siehe:
//   - docs/database/Database.md (fachlicher Entwurf)
//   - docs/AUTH_IDENTITY_RBAC_ARCHITEKTUR.md (Account/Person-Trennung, RoleAssignment, PersonRelationship)
//   - docs/ARCHITEKTUR_FINALISIERUNG.md (finales RoleAssignment-Modell, RLS-Konzept)
//   - docs/architecture/adr/0002-0006 (ACCEPTED)
//
// Noch NICHT enthalten: Event/Attendance/Task/Tournament/Match/Venue/
// Notification/AuditLog/JointTeam — folgen in einem eigenen, fachlichen
// Arbeitspaket. Season/AgeGroup/TeamSeason (Fußball-Saisonverwaltung)
// kamen in Phase 9 hinzu, siehe docs/PHASE_9_FOOTBALL_SEASON_REPORT.md.
// Prisma ist absichtlich auf ^6.x gepinnt (nicht 7), siehe
// docs/architecture/adr/0002-authentication-strategy.md.
//
// RLS-Hinweis: Row-Level-Security wird NICHT deklarativ über Prisma
// abgebildet (Prisma 6 hat dafür keine native Unterstützung), sondern
// gezielt per SQL-Migration ergänzt — siehe die Migration, die auf die
// `prisma migrate dev`-Migration dieses Schemas folgt, sowie
// docs/PHASE_2_CORE_REPORT.md, Abschnitt "RLS-Implementierung".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// Vereinsrollen, siehe docs/product/Roles-and-Permissions.md.
/// Plattformrollen sind bewusst ein eigenes Enum (PlatformRole), siehe ADR 0004.
enum Role {
  TENANT_ADMIN
  DEPARTMENT_ADMIN
  YOUTH_DIRECTOR
  TEAM_MANAGER
  COACH
  ASSISTANT_COACH
  PLAYER
  MEMBER
  GUEST
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

enum ScopeType {
  TENANT
  DEPARTMENT
  TEAM
}

/// Elternteil/Sorgeberechtigter ist bewusst KEINE RBAC-Rolle, siehe ADR 0005.
enum RelationshipType {
  PARENT
  LEGAL_GUARDIAN
  EMERGENCY_CONTACT
}

enum RelationshipStatus {
  PENDING
  VERIFIED
  REVOKED
}

/// Lebenszyklus einer TeamMember-Zeile — bewusst nur zwei Zustände, keine
/// weitergehende Historisierung (kein validFrom/validUntil, kein Audit-Log)
/// in dieser Phase, siehe TeamMember-Kommentar.
enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

/// Grobe Sportart-Klassifizierung einer `Department` (Phase 9). Bewusst ein
/// Enum statt einer konfigurierbaren Entity — siehe Abschnitt "Sportart" in
/// docs/PHASE_9_FOOTBALL_SEASON_REPORT.md: die Liste der Sportarten eines
/// typischen deutschen Mehrsparten-Vereins ist klein und ändert sich
/// selten; eine eigene verwaltbare Entity (mit CRUD/Seed/Admin-UI) wäre für
/// diesen Zweck unnötige Komplexität. Erweiterbar durch simples Hinzufügen
/// eines neuen Werts, keine Migration bestehender Daten nötig. `OTHER` ist
/// der bewusste Auffangwert für alles, was (noch) keinen eigenen Wert hat —
/// keine erschöpfende Sportarten-Liste, siehe Auftrag ("keinen riesigen
/// Sportarten-Katalog implementieren").
enum SportType {
  FOOTBALL
  TENNIS
  STOCK_SPORT
  CYCLING
  OTHER
}

/// Lebenszyklus einer `Season`. Bewusst nur drei Zustände, keine
/// weitergehende Workflow-Engine (analog zu `TeamMemberStatus`/
/// `AccountInvitationStatus`).
enum SeasonStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

/// Lebenszyklus einer `TeamSeason`-Zuordnung — identisches Muster zu
/// `TeamMemberStatus` (siehe dort): eine Mannschaft kann sich aus einer
/// Saison zurückziehen, ohne dass die Zeile gelöscht wird.
enum TeamSeasonStatus {
  ACTIVE
  INACTIVE
}

/// Lebenszyklus einer AccountInvitation. Bewusst nur vier Zustände, keine
/// Workflow-Engine — siehe Modellkommentar an AccountInvitation.
enum AccountInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// better-auth-eigene Modelle (generiert via `npx @better-auth/cli generate`,
// siehe packages/auth/src/index.ts). `User` ist um das domänenspezifische
// Feld `status` erweitert (packages/auth: `user.additionalFields`).
//
// Diese vier Modelle sind bewusst NICHT tenant-partitioniert und tragen
// KEIN Row-Level-Security — siehe docs/ARCHITEKTUR_FINALISIERUNG.md,
// Abschnitt 8 ("globale Identitätsebene").
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions                Session[]
  accounts                Account[]
  memberships             Membership[]
  platformRoleAssignments PlatformRoleAssignment[]
  sentInvitations         AccountInvitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Plattformebene (mandantenübergreifend, siehe ADR 0004)
// ---------------------------------------------------------------------------

/// Mandantenübergreifende Plattformrolle, direkt am User — bewusst getrennt
/// von RoleAssignment (Person-basiert, tenant-partitioniert).
model PlatformRoleAssignment {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole
  createdAt DateTime     @default(now())

  @@unique([userId, role])
  @@map("platform_role_assignment")
}

// ---------------------------------------------------------------------------
// Mandantenebene (RLS-geschützt, siehe Migration + docs/ARCHITEKTUR_FINALISIERUNG.md Abschnitt 8)
//
// Ausnahme: `Tenant` selbst trägt keine RLS-Policy — der Tenant ist die
// Wurzel der Mandantenhierarchie, nicht durch seine eigene tenant_id
// gefiltert. Zugriff auf Tenant-Zeilen (z. B. Slug-Lookup beim Login,
// "meine Vereine" über Membership→Person) erfolgt applikationsseitig.
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  departments         Department[]
  persons             Person[]
  roleAssignments     RoleAssignment[]
  personRelationships PersonRelationship[]
  teams               Team[]
  teamMembers         TeamMember[]
  accountInvitations  AccountInvitation[]
  seasons             Season[]
  ageGroups           AgeGroup[]
  teamSeasons         TeamSeason[]

  @@map("tenant")
}

model Department {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  /// Phase 9: grobe Sportart-Klassifizierung — bewusst KEIN
  /// fußballspezifisches Feld (siehe Auftrag: "Department und Team bleiben
  /// generisch"), sondern derselbe generische Klassifizierer, den jede
  /// andere Abteilung auch trägt (Tennis, Radsport, …). Ausschließlich
  /// dieses Feld entscheidet, ob eine `Team` dieser Department eine
  /// `TeamSeason` erhalten darf — siehe TeamSeason-Kommentar.
  sportType SportType @default(OTHER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teams           Team[]
  roleAssignments RoleAssignment[]
  seasons         Season[]

  @@unique([tenantId, name])
  // Composite-Unique (zusätzlich zum bereits eindeutigen `id`), damit
  // Team/RoleAssignment per Composite-Foreign-Key gegen (tenantId, id)
  // referenzieren können — siehe Kommentar an RoleAssignment weiter unten.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("department")
}

model Team {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "team_tenant_fkey")
  departmentId String
  // Composite FK (tenantId, departmentId) → department(tenantId, id) statt
  // nur (departmentId) → department(id): erzwingt auf DB-Ebene, dass ein
  // Team nur eine Department DESSELBEN Tenants referenzieren kann. Mit nur
  // `departmentId` allein wäre ein Team mit `tenantId=A` referenzierbar auf
  // eine Department mit `tenantId=B` — das ist der gleiche
  // Cross-Tenant-Konsistenzfehler, der für RoleAssignment behoben wurde.
  department   Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roleAssignments RoleAssignment[]
  teamMembers     TeamMember[]
  teamSeasons     TeamSeason[]

  @@unique([departmentId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([departmentId])
  @@map("team")
}

/// Vereinsmitglied — mandantenbezogen, existiert unabhängig von einem
/// `User`-Account (z. B. minderjähriges Mitglied ohne eigenen Login).
/// Siehe ADR 0003.
model Person {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  firstName    String
  lastName     String
  birthDate    DateTime?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships             Membership[]
  roleAssignments         RoleAssignment[]     @relation("PersonRoleAssignments")
  grantedRoleAssignments  RoleAssignment[]     @relation("GrantedByPerson")
  relationshipsAsGuardian PersonRelationship[] @relation("RelationshipFromPerson")
  relationshipsAsChild    PersonRelationship[] @relation("RelationshipToPerson")
  verifiedRelationships   PersonRelationship[] @relation("RelationshipVerifiedBy")
  teamMemberships         TeamMember[]         @relation("PersonTeamMemberships")
  accountInvitations      AccountInvitation[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("person")
}

/// Verknüpft einen globalen Login-Account (`User`) mit einer mandantenbezogenen
/// Person ("dieser Login ist diese Person"). Kein Rollenträger, siehe ADR 0003.
///
/// Cross-Tenant-Konsistenz geprüft (Phase 3): `Membership` trägt bewusst
/// KEIN eigenes `tenantId` (globale Identitätsebene, siehe
/// docs/ARCHITEKTUR_FINALISIERUNG.md Abschnitt 8) und hat daher keinen
/// eigenen Tenant-Anspruch, der zu `person.tenantId` inkonsistent werden
/// könnte — ein Composite-FK ist hier weder möglich noch nötig. Die
/// Konsistenz ist strukturell gegeben: welchem Tenant eine Membership
/// "angehört" ergibt sich ausschließlich aus der referenzierten Person.
model Membership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  personId  String           @unique
  person    Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("membership")
}

/// Scope-basierte Rollenzuweisung, siehe ADR 0004 und
/// docs/ARCHITEKTUR_FINALISIERUNG.md Abschnitt 4. Scope-Konsistenz
/// (TENANT ⇒ department/team NULL, DEPARTMENT ⇒ department gesetzt,
/// TEAM ⇒ team gesetzt) wird per CHECK-Constraint in der SQL-Migration
/// erzwungen, da Prisma 6 mehrspaltige CHECK-Constraints nicht deklarativ
/// unterstützt.
///
/// Cross-Tenant-Konsistenz von `personId`/`departmentId`/`teamId` (verhindert,
/// dass eine RoleAssignment mit `tenantId=A` auf eine Person/Department/Team
/// mit `tenantId=B` zeigt) wird NICHT per Trigger, sondern durchgängig per
/// Composite Foreign Key durchgesetzt: `person`/`department`/`team`
/// referenzieren jeweils `(tenantId, id)` statt nur `id`. PostgreSQL wendet
/// dabei MATCH SIMPLE an — ist eine der referenzierenden Spalten NULL (z. B.
/// `departmentId` bei TENANT-Scope), gilt der Constraint automatisch als
/// erfüllt; ist die Spalte gesetzt, muss die referenzierte Zeile exakt
/// dieselbe `tenantId` haben. Siehe docs/PHASE_2_CORE_REPORT.md, Abschnitt
/// 20/21 und docs/PHASE_3_CLUB_STRUCTURE_REPORT.md.
///
/// `grantedByPersonId` bleibt bewusst eine EINFACHE (nicht-composite) FK:
/// es ist ein rein informatives Attributionsfeld ("wer hat das vergeben"),
/// nicht Teil der fachlichen Bedeutung der Zeile — anders als `personId`
/// (wem die Rolle gehört) oder `departmentId`/`teamId` (welcher Scope). Ein
/// Composite-FK wäre hier zusätzlich technisch unsauber: `ON DELETE SetNull`
/// auf einer Composite-FK würde bei Auslösung versuchen, auch das (NOT
/// NULL) `tenantId`-Feld zu leeren, was einen Constraint-Verstoß zur
/// Laufzeit erzeugen würde (von Prisma selbst als Warnung angezeigt).
/// Cross-Tenant-Werte hier werden applikationsseitig ausgeschlossen: der
/// Wert wird ausschließlich serverseitig aus der aktuellen,
/// Tenant-validierten Person des Aufrufers gesetzt, nie aus Client-Input.
model RoleAssignment {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personId     String
  person       Person      @relation("PersonRoleAssignments", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  role         Role
  scopeType    ScopeType
  departmentId String?
  department   Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  teamId       String?
  team         Team?       @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)
  validFrom    DateTime?
  validUntil   DateTime?

  grantedByPersonId String?
  grantedByPerson   Person? @relation("GrantedByPerson", fields: [grantedByPersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Duplicate-Schutz (Phase 5): eine identische aktive Zuweisung (gleiche
  // Person, Rolle, Scope und ggf. Department/Team) darf nicht mehrfach
  // existieren. Nicht als `@@unique` deklarierbar — `departmentId`/`teamId`
  // sind nullable, und SQL behandelt NULL <> NULL, sodass ein normaler
  // Unique-Index zwei TENANT-Scope-Zeilen derselben Person/Rolle (beide mit
  // departmentId=teamId=NULL) NICHT als Duplikat erkennen würde. Stattdessen
  // ein funktionaler Unique-Index mit COALESCE(..., '') in der Migration
  // `20260821_add_role_assignment_uniqueness` (Prisma 6 unterstützt
  // Expression-Indizes nicht deklarativ).
  @@index([tenantId])
  @@index([personId])
  @@index([departmentId])
  @@index([teamId])
  @@map("role_assignment")
}

/// Gerichtete, verifizierungspflichtige Beziehung zwischen zwei Personen
/// desselben Tenants (z. B. Eltern-Kind). KEINE RBAC-Rolle, siehe ADR 0005.
///
/// `fromPerson`/`toPerson` referenzieren `Person` über Composite Foreign Keys
/// `(tenantId, personId) → person(tenantId, id)` — verhindert, dass eine
/// Beziehung tenantübergreifend zwei Personen unterschiedlicher Vereine
/// verknüpft. `verifiedByPersonId` bleibt bewusst eine einfache FK (reines
/// Attributionsfeld, gleiche Begründung wie `RoleAssignment.grantedByPersonId`
/// oben — inklusive derselben `SetNull`-auf-Composite-FK-Problematik).
model PersonRelationship {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromPersonId    String
  fromPerson      Person             @relation("RelationshipFromPerson", fields: [tenantId, fromPersonId], references: [tenantId, id], onDelete: Restrict)
  toPersonId      String
  toPerson        Person             @relation("RelationshipToPerson", fields: [tenantId, toPersonId], references: [tenantId, id], onDelete: Restrict)
  type            RelationshipType
  status          RelationshipStatus @default(PENDING)
  isLegalGuardian Boolean            @default(false)
  validFrom       DateTime?
  validUntil      DateTime?

  verifiedByPersonId String?
  verifiedByPerson   Person? @relation("RelationshipVerifiedBy", fields: [verifiedByPersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromPersonId, toPersonId, type])
  @@index([tenantId])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@map("person_relationship")
}

/// Fachliche Mannschaftszugehörigkeit — "diese Person gehört zu dieser
/// Mannschaft" — und ausdrücklich NICHTS sonst. Drei separate, bewusst
/// nicht vermischte Konzepte im Datenmodell (siehe docs/database/Database.md):
///
///   - `Membership`      = Login-Zuordnung (welcher `User` ist welche `Person`)
///   - `TeamMember`       = fachliche Mannschaftszugehörigkeit (dieses Modell)
///   - `RoleAssignment`   = Berechtigung (was darf diese Person tun)
///
/// Ein Spieler hat nur `TeamMember`. Ein Trainer hat zusätzlich eine
/// `RoleAssignment(role: COACH, scopeType: TEAM, teamId: ...)` — beide
/// Zeilen existieren unabhängig voneinander; das Entfernen der einen
/// berührt die andere nicht.
///
/// Namensentscheidung: nicht `TeamMembership`, obwohl das Arbeitspaket
/// diesen Namen als Arbeitsbezeichnung vorschlug. `TeamMembership` würde im
/// selben Schema neben dem bereits existierenden, semantisch komplett
/// anderen `Membership`-Modell (Login-Bindung, siehe oben) stehen — beide
/// mit identischem "-ship"-Suffix, beide potenziell in denselben
/// Log-Zeilen/Fehlermeldungen/Code-Reviews auftauchend. Genau diese
/// Verwechslungsgefahr sollte laut Auftrag ausgeschlossen werden.
/// `TeamAssignment` wurde ebenfalls verworfen: `RoleAssignment` deckt
/// bereits `scopeType: TEAM` ab, ein `TeamAssignment` läge fachlich
/// gefährlich nah an "RoleAssignment mit Team-Scope". `TeamMember` trägt
/// keines der beiden kollidierenden Suffixe, liest sich als das, was es
/// ist (ein Eintrag im Kader einer Mannschaft), und deckt sich mit der im
/// Auftrag bereits vorgegebenen REST-Vokabel `/teams/:teamId/members`.
///
/// Cross-Tenant-Konsistenz nach demselben Muster wie RoleAssignment/
/// PersonRelationship (Phase 3): `person`/`team` referenzieren jeweils
/// `(tenantId, id)` statt nur `id` (Composite FK, PostgreSQL MATCH SIMPLE).
///
/// `status` (ACTIVE/INACTIVE) statt Hard-Delete: `DELETE
/// /api/v1/teams/:teamId/members/:personId` setzt `status = INACTIVE`
/// statt die Zeile zu löschen — damit bleibt nachvollziehbar, dass eine
/// Person einmal Teil der Mannschaft war (z. B. Spieler, der die Mannschaft
/// mitten in der Saison verlässt), ohne eine vollständige
/// Historisierung (validFrom/validUntil, Audit-Log) einzuführen. Die
/// Unique-Regel "keine doppelte AKTIVE Zuordnung derselben Person zur
/// selben Mannschaft" ist deshalb ein PARTIELLER Unique-Index nur auf
/// `status = 'ACTIVE'` (Prisma 6 unterstützt partielle Indizes nicht
/// deklarativ — siehe SQL-Migration) statt eines einfachen
/// `@@unique([personId, teamId])`, sonst könnte eine einmal inaktive
/// Person nie wieder derselben Mannschaft hinzugefügt werden.
model TeamMember {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personId  String
  person    Person           @relation("PersonTeamMemberships", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  teamId    String
  team      Team             @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)
  status    TeamMemberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
  @@index([personId])
  @@index([teamId])
  @@map("team_member")
}

/// Account-Einladung (Phase 6): "lade diese Person zu einem Login-Account
/// ein" — der einzige Weg, wie eine `Person` erstmals mit einem `User`
/// verknüpft wird (über eine `Membership`, sobald die Einladung akzeptiert
/// wurde). Bewusst eine eigene Entity statt eines Felds an `Person`: der
/// Lebenszyklus (Token, Ablauf, mehrere Einladungsversuche über die Zeit)
/// hat nichts mit der fachlichen Bedeutung von `Person` zu tun.
///
/// Sicherheit: Es wird ausschließlich `tokenHash` gespeichert, niemals der
/// rohe Token (siehe `apps/api/src/invitations/invitations.service.ts` —
/// `crypto.randomBytes` + `crypto.createHash('sha256')`, keine
/// selbstgebaute Kryptographie). Der rohe Token existiert nur einmalig im
/// Response-Body der Erstellung bzw. im E-Mail-Text — nie in Logs, nie in
/// Fehlermeldungen.
///
/// `email` ist bewusst auf der Einladung gespeichert (nicht nur auf
/// `Person.contactEmail`, das optional/veränderlich ist) — die Einladung
/// bindet sich an eine konkrete Adresse zum Einladungszeitpunkt; beim
/// Akzeptieren wird geprüft, dass die eingeloggte Session exakt zu dieser
/// Adresse gehört (siehe Service).
///
/// Höchstens eine PENDING-Einladung pro Person gleichzeitig — partieller
/// Unique-Index in der Migration (Prisma 6 unterstützt WHERE-Klauseln in
/// `@@unique` nicht deklarativ, siehe TeamMember für dasselbe Muster).
/// Ein erneutes Versenden widerruft die vorherige PENDING-Einladung
/// (macht ihren Token ungültig) statt eine zweite parallel gültige zu
/// erzeugen.
///
/// BEWUSST OHNE Row-Level-Security (anders als die übrigen tenant-
/// gebundenen Tabellen) — exakt derselbe Grund wie bei `Tenant` (siehe
/// dort): der öffentliche Annahme-Flow (`GET /api/v1/invitations/:token`,
/// `POST /api/v1/invitations/accept`) kennt den Tenant naturgemäß noch
/// NICHT — er wird über den Token erst ermittelt, ein klassisches
/// Henne-Ei-Problem für tenant-kontext-basiertes RLS. Die Sicherheits-
/// grenze hier ist nicht die Tenant-Zugehörigkeit, sondern der Besitz des
/// rohen Tokens (256 Bit Entropie, siehe `tokenHash`) — funktional
/// äquivalent zu jedem Passwort-Reset-Link-Muster. Alle verwaltenden
/// Operationen (anlegen/auflisten/widerrufen durch TENANT_ADMIN) filtern
/// dennoch explizit nach `tenantId` in `InvitationsService` (Application-
/// Layer-Schutz, auch ohne DB-erzwungenes RLS) und laufen weiterhin über
/// `getTenantPrisma` für die dabei mitbenötigten RLS-geschützten
/// `Person`-Zugriffe. Die Composite-FK `(tenantId, personId) →
/// person(tenantId, id)` bleibt bestehen — verhindert weiterhin auf
/// DB-Ebene, dass eine Einladung eine Person eines anderen Tenants
/// referenziert, unabhängig von RLS.
model AccountInvitation {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  personId        String
  person          Person                  @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  email           String
  tokenHash       String                  @unique
  status          AccountInvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  invitedByUser   User                    @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedAt      DateTime?
  createdAt       DateTime                @default(now())

  @@index([tenantId])
  @@index([personId])
  @@index([email])
  @@map("account_invitation")
}

/// Saison einer Abteilung (Phase 9) — bewusst sportartenübergreifend
/// generisch modelliert (kein Teil eines "Football-Moduls"), da Saisons
/// fachlich für jede Abteilung sinnvoll sind (eine Tennis-Saison ist
/// genauso denkbar wie eine Fußball-Saison) — siehe
/// docs/PHASE_9_FOOTBALL_SEASON_REPORT.md, Abschnitt "Season-Modell".
///
/// Höchstens eine ACTIVE Season pro Department gleichzeitig — partieller
/// Unique-Index in der Migration (gleiches Muster wie TeamMember/
/// AccountInvitation, siehe dort: Prisma 6 bildet WHERE-Klauseln in
/// `@@unique` nicht deklarativ ab). `startsAt < endsAt` wird per
/// CHECK-Constraint in derselben Migration erzwungen. Überschneidende
/// Zeiträume zwischen PLANNED/ACTIVE/COMPLETED Saisons werden bewusst
/// NICHT verboten (siehe Auftrag: legitime Übergänge, z. B. Vorbereitung
/// der nächsten Saison während die aktuelle noch läuft).
model Season {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departmentId String
  // Composite FK (tenantId, departmentId) → department(tenantId, id),
  // gleiches Muster wie Team → Department (siehe dort).
  department   Department   @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  name         String
  startsAt     DateTime
  endsAt       DateTime
  status       SeasonStatus @default(PLANNED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  teamSeasons TeamSeason[]

  @@unique([departmentId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([departmentId])
  @@map("season")
}

/// Konfigurierbare Altersklasse (Phase 9) — bewusst eine Entity statt
/// eines Enums mit hartcodierten deutschen Jugendklassen (G-/F-/E-/D-/C-/
/// B-/A-Jugend), siehe docs/PHASE_9_FOOTBALL_SEASON_REPORT.md, Abschnitt
/// "Altersklassen": ein Enum würde die Plattform dauerhaft an ein
/// deutsches Jugendfußball-Schema binden und spätere andere Verbände,
/// Länder oder reine Erwachsenenkategorien erschweren. Tenant-weit statt
/// department-gebunden modelliert — eine Altersklasse wie "Herren" ist
/// grundsätzlich nicht zwangsläufig fußballspezifisch, auch wenn sie
/// aktuell ausschließlich über TeamSeason (Fußball) verwendet wird.
/// Noch kein DELETE-Endpoint, solange Verwendungs-/Archivierungsregeln
/// nicht geklärt sind (siehe Auftrag).
model AgeGroup {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons TeamSeason[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("age_group")
}

/// Saisonale Zuordnung eines bestehenden `Team` zu einer `Season` +
/// `AgeGroup` (Phase 9). Das `Team` selbst bleibt die dauerhafte
/// organisatorische Identität über Saisons hinweg — ein real existierender
/// Verein führt eine Kaderbezeichnung wie "E1" typischerweise über Jahre
/// fort, auch wenn sich Altersklasse und Spieler von Saison zu Saison
/// ändern (die Spieler "wachsen durch" die Altersklassen, der
/// Mannschafts-Slot "E1" bleibt bestehen). Ein alternatives Modell (jede
/// Saison ein komplett neues `Team`) wurde bewusst verworfen: es würde
/// RoleAssignments/TeamMember/Rollenverlauf pro Saison neu verknüpfen
/// müssen, ohne einen fachlichen Vorteil zu bieten — siehe
/// docs/PHASE_9_FOOTBALL_SEASON_REPORT.md, Abschnitt "Team vs.
/// TeamSeason" für die ausführliche Begründung.
///
/// `team.name` bleibt die dauerhafte organisatorische Bezeichnung;
/// `displayName` ist eine optionale, rein saisonale Anzeige-Überschreibung
/// (z. B. falls ein Verein "E1" in einer Saison anders benennen möchte),
/// keine Datenverdopplung im Regelfall (NULL, wenn ungenutzt).
///
/// Bewusst NICHT auf Datenbankebene erzwungen, dass `team.department`
/// tatsächlich `sportType = FOOTBALL` ist — dafür wäre ein Trigger nötig,
/// der beim Schreiben von `team_season` die `department`-Tabelle über
/// `team` hinweg nachschlägt, was in reinem SQL/Postgres-Constraints ohne
/// eigene Trigger-Funktion nicht ausdrückbar ist. Für den aktuellen Umfang
/// unverhältnismäßige Komplexität (siehe Auftrag: "sofern DB-seitig
/// sinnvoll möglich"). Stattdessen anwendungsseitig in
/// `TeamSeasonsService.create()` geprüft (klare Fehlermeldung statt
/// stillem Fehlverhalten) und durch einen dedizierten Test abgesichert.
model TeamSeason {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teamId      String
  team        Team             @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict)
  seasonId    String
  season      Season           @relation(fields: [tenantId, seasonId], references: [tenantId, id], onDelete: Restrict)
  ageGroupId  String
  ageGroup    AgeGroup         @relation(fields: [tenantId, ageGroupId], references: [tenantId, id], onDelete: Restrict)
  displayName String?
  status      TeamSeasonStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([teamId, seasonId])
  @@index([tenantId])
  @@index([teamId])
  @@index([seasonId])
  @@index([ageGroupId])
  @@map("team_season")
}
