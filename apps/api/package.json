    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.1",
    "@swc/core": "1.16.0",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "@verevia/config": "workspace:*",
    "eslint": "^9.18.0",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.10"
