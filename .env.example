# Entwicklungsumgebung
# Diese Datei enthält nur Beispielwerte. Kopiere sie zu .env.local und fülle echte Werte aus.
# Keine echten Secrets in diese Datei eintragen (siehe .gitignore).

# Anwendung
NODE_ENV=development
APP_NAME=Verevia
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

# Mandant (Modus)
TENANT_MODE=shared

# Datenbank (siehe infrastructure/docker/docker-compose.yml für lokale Entwicklung)
#
# WICHTIG: Zwei unterschiedliche Rollen, siehe docs/PHASE_2_CORE_REPORT.md:
# - Migrationen (`prisma migrate dev`) laufen über die Superuser-Rolle aus
#   docker-compose.yml (POSTGRES_USER/-PASSWORD).
# - Der laufende App-Prozess MUSS über die separate, nicht-privilegierte
#   Rolle `verevia_app` verbinden (wird durch die Migration
#   `add_non_superuser_app_role` angelegt) - PostgreSQL-Superuser umgehen
#   Row Level Security grundsätzlich, RLS würde sonst wirkungslos bleiben.
DATABASE_URL=postgresql://verevia_app:change-me@localhost:5432/verevia

# Authentifizierung (better-auth, siehe packages/auth)
# BETTER_AUTH_SECRET: lokal mit `openssl rand -base64 32` erzeugen, niemals committen.
BETTER_AUTH_SECRET=change-me-with-a-strong-secret
BETTER_AUTH_URL=http://localhost:3001

# Optional: Externe Services (später, siehe ARCHITEKTUR_BERICHT.md)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
