# Entwicklungsumgebung
# Diese Datei enthält nur Beispielwerte. Kopiere sie zu .env.local und fülle echte Werte aus.

# Anwendung
NODE_ENV=development
APP_NAME=Verevia
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Datenbank
DATABASE_URL=postgresql://verevia:change-me@localhost:5432/verevia

# Authentifizierung
AUTH_SECRET=change-me-with-a-strong-secret

# Mandant (Modus)
TENANT_MODE=shared

# Optional: Externe Services (später)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
