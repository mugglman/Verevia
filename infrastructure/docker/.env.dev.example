# Template for the permanent Verevia DEV deployment's secrets, see
# docs/PHASE_7_DEV_DEPLOYMENT_REPORT.md.
#
# This file is versioned (it's a template with NO real values). The real
# file lives ONLY on the VPS at /srv/verevia/dev/.env, is never committed,
# and should be chmod 600, owned by maik (see the deployment report for
# the exact commands used).
#
# Generate secure values with, e.g.:
#   openssl rand -base64 32   (for passwords/secrets)

# --- PostgreSQL ---
# Two-role model, same as local development (see docs/DEVELOPMENT.md /
# PHASE_2_CORE_REPORT.md): a superuser role for migrations, and a
# separate, non-privileged `verevia_app` role (created BY the
# `add_non_superuser_app_role` migration, not here) for the running
# api/web containers — PostgreSQL superusers bypass Row-Level-Security
# unconditionally, so the application must never connect as one.
POSTGRES_SUPERUSER=verevia
POSTGRES_SUPERUSER_PASSWORD=change-me-generate-a-real-secret

# Used only by the one-off `migrate` service (prisma migrate deploy +
# seed) — superuser role, internal Docker network address.
MIGRATE_DATABASE_URL=postgresql://verevia:change-me-generate-a-real-secret@verevia-dev-postgres:5432/verevia

# Used by the persistent api/web containers — non-superuser `verevia_app`
# role. The role itself and ITS password are set by the
# `add_non_superuser_app_role` migration's hardcoded 'change-me' — for
# any environment beyond local development that password MUST be changed
# separately from this file (see the migration's own comment and
# docs/PHASE_7_DEV_DEPLOYMENT_REPORT.md, Abschnitt Secrets) by connecting
# once as the superuser and running:
#   ALTER ROLE verevia_app WITH PASSWORD '<new-secret>';
# then updating these two URLs to match.
API_DATABASE_URL=postgresql://verevia_app:change-me-generate-a-real-secret@verevia-dev-postgres:5432/verevia
WEB_DATABASE_URL=postgresql://verevia_app:change-me-generate-a-real-secret@verevia-dev-postgres:5432/verevia

# --- Authentication (better-auth, see packages/auth) ---
BETTER_AUTH_SECRET=change-me-generate-a-real-secret

# --- Application ---
PILOT_TENANT_SLUG=tsv-benediktbeuern
